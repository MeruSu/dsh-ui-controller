{
  "name": "dsh-ui-controller",
  "version": "0.2.8",
  "description": "Inspect and control the UI other plugins register into DeepSeek Harness slots (visibility, order, mirrored entries).",
  "license": "MIT",
  "author": {
    "name": "MeruSu"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MeruSu/dsh-ui-controller.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "ui"
  ],
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "locale",
    "icon.png",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "icon": "./icon.png"
}
